# ─────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/replaylab
DB_USERNAME=replaylab
DB_PASSWORD=replaylab123

# ─────────────────────────────────────────────────────────────────
# JWT (change this to a long random string in any deployment)
# Never commit real secrets to version control
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=ReplaceThisWithAVeryLongRandomStringAtLeast64CharactersLong!!!
JWT_EXPIRY_MS=86400000

# ─────────────────────────────────────────────────────────────────
# ML Service
# ─────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────
# CORS (comma separated list of allowed origins)
# ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# Replay protection freshness window (seconds)
# Requests older than this will be rejected as potentially stale
# ─────────────────────────────────────────────────────────────────
REPLAY_FRESHNESS_WINDOW=300

# ─────────────────────────────────────────────────────────────────
# Optional: LLM integration (disabled by default)
# If set, the explanation service will use the LLM instead of the
# deterministic rule-based explainer.
# NEVER commit real API keys to version control.
# ─────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o-mini
